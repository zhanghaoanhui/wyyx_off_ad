#!name=网易严选 去开屏广告
#!desc=屏蔽网易严选 App 开屏推广素材，启动直接进入首页
#!author=zhanghaoanhui
#!homepage=https://github.com/zhanghaoanhui/wyyx_off_ad

[Script]
http-response ^https:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json(\?|$) script-path=https://raw.githubusercontent.com/zhanghaoanhui/wyyx_off_ad/main/wyyx_off_ad.js, requires-body=true, timeout=10, tag=严选开屏-getBootMedia
http-response ^https:\/\/support\.you\.163\.com\/appversync\/check\.do(\?|$) script-path=https://raw.githubusercontent.com/zhanghaoanhui/wyyx_off_ad/main/wyyx_off_ad.js, requires-body=true, timeout=10, tag=严选开屏-appversync

[MITM]
hostname = support.you.163.com
